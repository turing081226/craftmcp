# Copy this file to mcp_server/.env and fill in your own values.
# Absolute path to the Paper server folder, e.g. <your clone>\mc_server
MC_SERVER_DIR=C:\path\to\craftmcp\mc_server
MC_RCON_PASSWORD=
# Optional: localhost RCON port and total connect/auth/command deadline in seconds.
MC_RCON_PORT=25575
MC_RCON_TIMEOUT=5
# execute_command accepts this single target ID until the shared runtime registry is connected.
MC_RUNTIME_ID=default
# Optional when Gradle is not on the MCP process PATH.
# GRADLE_HOME=C:\Gradle\gradle-8.14.6
# Optional: let the AI type, move, look and click in the Minecraft client (see docs/client-capture.md).
# CRAFTMCP_GAME_INPUT=1
